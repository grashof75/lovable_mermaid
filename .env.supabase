############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

# PostgreSQL password for the postgres user
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT Secret - Use a strong random string (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Secret key base for realtime service
# Generate with: openssl rand -base64 32
SECRET_KEY_BASE=your-super-secret-key-base-with-at-least-32-characters-long

# Logflare API Key
# Generate with: openssl rand -base64 32
LOGFLARE_API_KEY=your-super-secret-logflare-api-key

# Service role key (admin access)
# This will be generated automatically from JWT_SECRET.
# You can also set it manually if needed
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsaG9zdCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2ODEyMDAwMDAsImV4cCI6MTk5Njc3NjAwMH0.YOUR_GENERATED_KEY

# Anonymous key (public access)
# This will be generated automatically from JWT_SECRET.
# You can also set it manually if needed
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsaG9zdCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjgxMjAwMDAwLCJleHAiOjE5OTY3NzYwMDB9.YOUR_GENERATED_KEY

############
# API Settings
############

# The domain/IP where Supabase will be accessible
# For VPS: use your domain or IP address (e.g., https://supabase.yourdomain.com or http://YOUR_VPS_IP:8000)
PUBLIC_SUPABASE_URL=http://localhost:8000

# The URL of your application (for redirects)
SITE_URL=http://localhost:5173

# Additional redirect URLs (comma separated)
ADDITIONAL_REDIRECT_URLS=

############
# Database Settings
############

# PostgreSQL schemas to expose via REST API
PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Auth Settings
############

# Disable public signups (set to true to disable)
DISABLE_SIGNUP=false

# Enable email signup
ENABLE_EMAIL_SIGNUP=true

# Enable email autoconfirm (set to true for development)
ENABLE_EMAIL_AUTOCONFIRM=false

# Enable phone signup
ENABLE_PHONE_SIGNUP=false

# Enable phone autoconfirm
ENABLE_PHONE_AUTOCONFIRM=false

# JWT expiry time (in seconds)
JWT_EXPIRY=3600

############
# Email Settings (SMTP)
############

# SMTP configuration for sending emails
SMTP_ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SENDER_NAME=Your App Name

# Email templates paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Studio Settings
############

# Studio default organization and project names
STUDIO_DEFAULT_ORGANIZATION=My Organization
STUDIO_DEFAULT_PROJECT=My Project

############
# Storage Settings
############

# Enable WebP detection for image transformations
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Application Environment Variables (for your app)
############

# These will be used by your React application
VITE_SUPABASE_URL=${PUBLIC_SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${ANON_KEY}

############
# Optional: OpenAI Configuration
############

# If your app uses OpenAI for diagram generation
# VITE_OPENAI_API_KEY=your-openai-api-key
